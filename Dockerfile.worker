# BullMQ worker image. Week 1: job-run recording skeleton only.
# Media (ffmpeg) and transcription (faster-whisper) tooling are added with
# their modules (docs/05, docs/03) — keep this image lean until then.
FROM node:22-slim
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
CMD ["pnpm", "worker"]
