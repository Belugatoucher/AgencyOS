# BullMQ worker image. Media processing (docs/05 thumbnails, docs/01 HLS
# transcode + sprite sheets) runs here via a full ffmpeg. faster-whisper
# (docs/03) is added with Notes in week 6.
FROM node:22-slim
RUN corepack enable && apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
# ffmpeg/ffprobe resolve on PATH; FFMPEG_PATH overrides if needed.
CMD ["pnpm", "worker"]
