# BullMQ worker image. Media processing (docs/05 thumbnails, docs/01 HLS
# transcode + sprite sheets) runs via ffmpeg; Notes transcription (docs/03)
# runs faster-whisper + pyannote via scripts/transcribe.py. Audio stays on-box.
FROM node:22-slim
RUN corepack enable && apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg python3 python3-pip \
  && rm -rf /var/lib/apt/lists/*
# Transcription deps (large; pinned in production). HF_TOKEN enables pyannote.
RUN pip3 install --no-cache-dir --break-system-packages faster-whisper pyannote.audio
# Embeddings (docs/08): bge-small runs locally so client data stays on-box.
# Set EMBED_MODE=local to use it (dev/CI default is the hash embedder).
RUN pip3 install --no-cache-dir --break-system-packages sentence-transformers
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
# ffmpeg/ffprobe + python3 resolve on PATH; FFMPEG_PATH / TRANSCRIBE_CMD override.
CMD ["pnpm", "worker"]
