# Agency OS — local-only hosting (docker-compose.local.yml)
# cp .env.local-hosting.example .env.local-hosting, then fill the CHANGE_ME values.
# Generate secrets: openssl rand -hex 24   /   openssl rand -base64 32

APP_URL=http://127.0.0.1:3000
NODE_ENV=production

POSTGRES_PASSWORD=CHANGE_ME          # openssl rand -hex 24
REDIS_PASSWORD=CHANGE_ME             # openssl rand -hex 24
MINIO_ROOT_USER=agencyos
MINIO_ROOT_PASSWORD=CHANGE_ME        # openssl rand -hex 24 (8+ chars)

AUTH_SECRET=CHANGE_ME                # openssl rand -base64 32
APP_ENCRYPTION_KEY=CHANGE_ME         # openssl rand -base64 32
EMAIL_FROM="Agency OS <os@localhost>"
SEED_ADMIN_EMAIL=you@example.com

# Where BROWSERS reach MinIO for direct uploads/downloads (presigned URLs).
# Same machine: http://127.0.0.1:9000. Other devices: publish port 9000 over
# HTTPS (e.g. `tailscale serve --bg --https=9443 9000`) and put that URL here.
R2_PUBLIC_ENDPOINT=http://127.0.0.1:9000

# Worker embeddings: local (bundled bge-small) or hash (no model)
EMBED_MODE=local

# Optional: AI features
ANTHROPIC_API_KEY=
# Optional: real email instead of the dev mailbox
# SMTP_URL=smtp://user:pass@smtp.provider.com:587
