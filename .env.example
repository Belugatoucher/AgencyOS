# Agency OS — environment template
# Copy to .env and fill. NEVER commit .env (gitignored). Rotate anything ever pasted in a chat/ticket.

# App
APP_URL=https://os.youragency.com
NODE_ENV=production

# Core encryption key for stored OAuth tokens (gcal/ghl/canva/slack) — 32 bytes base64.
# Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Database & queue (Docker-internal hostnames; never expose ports publicly)
DATABASE_URL=postgresql://agencyos:CHANGE_ME@postgres:5432/agencyos
REDIS_URL=redis://redis:6379

# Auth (magic links) — SMTP for transactional mail
SMTP_URL=smtp://user:pass@smtp.provider.com:587
AUTH_SECRET=            # openssl rand -base64 32
EMAIL_FROM="Agency OS <os@youragency.com>"

# Cloudflare R2 (private bucket; separate token for backups)
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET=
R2_BUCKET=agencyos
R2_BACKUP_ACCESS_KEY=
R2_BACKUP_SECRET=
R2_BACKUP_BUCKET=agencyos-backups

# AI
ANTHROPIC_API_KEY=

# GoHighLevel (leave empty until you have GHL — lead_mode=manual needs none of it)
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_WEBHOOK_SECRET=

# Slack app (doc 15) — webhook fallback for week 1
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Canva Connect (doc 17)
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# Google Calendar (doc 17)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional
SENTRY_DSN=
TURNSTILE_SITE_KEY=      # Cloudflare Turnstile on public forms (intake, share-link PIN)
TURNSTILE_SECRET_KEY=
